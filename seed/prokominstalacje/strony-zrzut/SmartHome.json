  "faq": [
   {
    "n": "01",
    "q": "Czy Ampio działa bez internetu?",
    "a": "Tak. Moduły, panele i czujniki pracują lokalnie w budynku, więc sceny i automatyki działają dalej. Internet jest potrzebny do sterowania z telefonu spoza domu.",
    "open": true
   },
   {
    "n": "02",
    "q": "Czy smart home da się zrobić w domu, który już stoi?",
    "a": "Tak, w zakresie zależnym od instalacji elektrycznej. Moduły montujemy w rozdzielnicy, a tam, gdzie nie ma przewodów, łączymy urządzenia bezprzewodowe w standardach obsługiwanych przez Ampio, np. Z-Wave czy ZigBee.",
    "open": false
   },
   {
    "n": "03",
    "q": "Czy jest abonament?",
    "a": "Sterowanie lokalne w budynku nie wymaga żadnych opłat. Czy i które usługi chmurowe producenta są płatne, potwierdzamy przy projekcie, zanim podpiszesz umowę.",
    "open": false
   },
   {
    "n": "04",
    "q": "Czy połączę Ampio z Apple Home albo Google Home?",
    "a": "Tak, przez standard Matter na serwerze Ampio. Producent testował integrację z produktami Google, Amazon i Apple.",
    "open": false
   },
   {
    "n": "05",
    "q": "Kiedy najlepiej planować smart home?",
    "a": "Przed rozpoczęciem instalacji elektrycznej. Wtedy przewody do paneli, czujników i rolet kładzie się razem z resztą, a rozdzielnica od razu ma miejsce na moduły.",
    "open": false
   },
   {
    "n": "06",
    "q": "Co się stanie, gdy zepsuje się jeden moduł?",
    "a": "Przestają działać tylko funkcje tego modułu, a reszta domu pracuje normalnie, bo Ampio nie ma jednego centralnego sterownika.",
    "open": false
   },
   {
    "n": "07",
    "q": "A gdy zabraknie prądu?",
    "a": "System wyłącza się jak zwykła instalacja i sam startuje po powrocie prądu. Jeśli ma działać przy awarii sieci, dokładamy zasilanie awaryjne.",
    "open": false
   },
   {
    "n": "08",
    "q": "Czy zostaną zwykłe włączniki?",
    "a": "Można je zostawić w prostszych układach. Przy większej liczbie funkcji wygodniejsze są szklane panele dotykowe.",
    "open": false
   },
   {
    "n": "09",
    "q": "Mam kilka apartamentów. Obsłużę je z jednego telefonu?",
    "a": "Tak. Aplikacja Ampio UNI przełącza się między instalacjami, a gościom albo obsłudze możesz dać dostęp na określony czas. Po zmianie obsługi zmieniamy też hasła lokalne.",
    "open": false
   },
   {
    "n": "10",
    "q": "Czy alarm Ampio wystarczy dla ubezpieczyciela?",
    "a": "Nie zawsze. Producent nie podaje klasy centrali Ampio według normy EN 50131. Gdy ubezpieczyciel wymaga certyfikowanego alarmu, montujemy centralę Satel albo Jablotron i łączymy ją z Ampio, żeby alarm uzbrajał się razem ze sceną Wyjście.",
    "open": false
   },
   {
    "n": "11",
    "q": "Kto zmieni scenę, gdy będę chciał coś inaczej?",
    "a": "My, często zdalnie. Proste zmiany, np. godziny harmonogramów, zrobisz sam w aplikacji.",
    "open": false
   }
  ],
