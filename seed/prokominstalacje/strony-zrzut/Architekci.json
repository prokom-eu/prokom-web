  "faq": [
   {
    "n": "01",
    "q": "Kiedy najlepiej nas zaprosić?",
    "a": "Na etapie koncepcji albo projektu budowlanego. Wtedy miejsce na szafę rack, przepusty, moc pod ładowarkę i sufity pod głośniki nic nie kosztują. Pomożemy też później, ale przed tynkami to ostatni moment bez kucia.",
    "open": true
   },
   {
    "n": "02",
    "q": "Czy muszę znać się na smart home i sieciach?",
    "a": "Nie. Wystarczą rzuty i rozmowa o potrzebach inwestora. Technikę bierzemy na siebie, a do projektu oddajemy proste wytyczne.",
    "open": false
   },
   {
    "n": "03",
    "q": "Co dostanę do projektu?",
    "a": "Plan urządzeń na rzutach, wytyczne kablowe, wymagania dla szafy rack i opis systemów prostym językiem. Zakres ustalamy na początku, zależnie od etapu i obiektu.",
    "open": false
   },
   {
    "n": "04",
    "q": "Czy pracujecie z projektem elektrycznym innego projektanta?",
    "a": "Tak. Instalacje niskoprądowe uzgadniamy z projektantem elektrycznym i wykonawcą. Zasilanie, moc i zabezpieczenia zostają w jego branży.",
    "open": false
   },
   {
    "n": "05",
    "q": "Czy pomożecie, jeśli inwestor wybierze innego wykonawcę?",
    "a": "Jedno pytanie do projektu zawsze. Zadzwoń i zapytaj. Pełne wytyczne przygotowujemy do projektów, które realizujemy. [SZEF: potwierdzić]",
    "open": false
   },
   {
    "n": "06",
    "q": "Ile to kosztuje inwestora?",
    "a": "Zależy od obiektu i zakresu. Na etapie projektu podajemy orientacyjny budżet w wariantach, a dokładną wycenę na piśmie po wizji lokalnej.",
    "open": false
   },
   {
    "n": "07",
    "q": "Jaki obszar obsługujecie?",
    "a": "Podhale i Małopolskę: salony w Rabce-Zdroju i Zakopanem. Przy większych inwestycjach jedziemy dalej, dojazd ustalamy indywidualnie.",
    "open": false
   },
   {
    "n": "08",
    "q": "Według których przepisów projektować teletechnikę w 2026 r.?",
    "a": "Stare warunki techniczne straciły moc 20.09.2026. Do 20.03.2028 można projektować według nich, jeśli inwestor złoży oświadczenie. Nowe warunki nie zostały jeszcze ogłoszone, dlatego stan prawny sprawdzamy przy każdym projekcie.",
    "open": false
   },
   {
    "n": "09",
    "q": "Czy dom jednorodzinny musi mieć światłowód?",
    "a": "Unijne rozporządzenie GIA obejmuje nowe budynki z wnioskiem o pozwolenie po 12.02.2026. Polska ustawa, która może zwolnić domy budowane na własne potrzeby, jest w przygotowaniu. Rura pod światłowód kosztuje niewiele, więc rekomendujemy ją w każdym projekcie.",
    "open": false
   },
   {
    "n": "10",
    "q": "Kto zajmuje się serwisem po odbiorze?",
    "a": "My. Inwestor dostaje jeden numer do wszystkich instalacji. Na montaż dajemy 24 miesiące gwarancji, a przeglądy robimy przed sezonem.",
    "open": false
   }
