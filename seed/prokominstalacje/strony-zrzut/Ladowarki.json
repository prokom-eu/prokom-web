  "faq": [
   {
    "n": "01",
    "q": "Którą ładowarkę Elzab wybrać?",
    "a": "Do domu zwykle CC Home: prosta, bez kart i aplikacji. Gdy z ładowarki korzystają goście, pracownicy albo dwa auta naraz, lepsza jest CC Wall z kartami RFID. Na otwarty parking hotelu czy firmy najlepiej pasuje wolnostojąca CC City z licznikiem MID.",
    "open": true
   },
   {
    "n": "02",
    "q": "Jaką moc ładowarki wybrać do domu?",
    "a": "Zależy od auta i przyłącza. Do ładowania nocą zwykle wystarcza 7,4 albo 11 kW. Nie ma sensu płacić za 22 kW, jeśli auto przyjmuje 11 kW, chyba że planujesz dwa auta albo zmianę samochodu.",
    "open": false
   },
   {
    "n": "03",
    "q": "Czy montujecie samą ładowarkę?",
    "a": "Tak. Możesz zamówić u nas samą ładowarkę Elzab EcoPower z montażem, bez innych instalacji. Jeśli planujesz też okablowanie, kamery czy smart home, przewód do ładowarki poprowadzimy przy okazji.",
    "open": false
   },
   {
    "n": "04",
    "q": "Czy ładowanie dla gości da się rozliczać?",
    "a": "Tak. CC City i wersje CC Wall z OCPP można połączyć z systemem operatora, który rozlicza ładowanie w aplikacji. Prostsza opcja to karty RFID tylko dla Twoich gości, a koszt ładowania doliczasz do pobytu.",
    "open": false
   },
   {
    "n": "05",
    "q": "Czy ładowarka dla gości pensjonatu wymaga UDT?",
    "a": "Ustawa przewiduje badanie UDT dla stacji ładowania przed oddaniem do eksploatacji, a nie ma jednoznacznego stanowiska, jak traktować ładowarki dla gości. Sprawdzamy to przy projekcie i pomagamy w zgłoszeniu.",
    "open": false
   },
   {
    "n": "06",
    "q": "Czy ładowarka działa w mróz?",
    "a": "Ładowarki Elzab EcoPower mają zakres pracy od −25°C. Zimą auto ładuje się wolniej przy zimnej baterii, a zasięg wyraźnie spada, zwłaszcza w mrozie.",
    "open": false
   },
   {
    "n": "07",
    "q": "Mieszkam w bloku. Mogę mieć ładowarkę?",
    "a": "Tak, ale w budynku z więcej niż trzema lokalami mieszkalnymi trzeba złożyć wniosek do zarządcy. We wspólnocie mieszkaniowej zgoda na punkt ładowania o mocy mniejszej niż 11 kW jest czynnością zwykłego zarządu. Pomożemy przygotować dokumenty.",
    "open": false
   },
   {
    "n": "08",
    "q": "Jaką gwarancję dostanę?",
    "a": "Na montaż dajemy 24 miesiące gwarancji PRO-KOM, a ładowarki mają gwarancję producenta. Na zgłoszenie odpowiadamy do 24 h w dni robocze: oddzwonimy albo odpiszemy.",
    "open": false
   },
   {
    "n": "09",
    "q": "Czy ładowarka współpracuje z fotowoltaiką?",
    "a": "Ładowanie można zaplanować na godziny produkcji z paneli. Czy ładowarka sama dopasuje moc do nadwyżki prądu, zależy od modelu i falownika. Sprawdzamy to przy doborze.",
    "open": false
   }
