exports[`snapshots (probka-wzorzec) > prokom/dostawy-lista 1`] = `"<div style="font:15px/1.6 Arial,Helvetica,sans-serif;color:#1F2421;max-width:600px"><p style="margin:0 0 14px">Dzień dobry,</p><p style="margin:0 0 14px">dziękujemy za listę zapytania — mamy ją. Przy dostawach dla firm i instytucji w godzinach pracy oddzwaniamy w ciągu 60 minut.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:separate;max-width:600px;margin:4px 0 18px;background:#EEF6EA;border-left:4px solid #45A02C;border-radius:12px"><tr><td style="padding:16px 20px 10px"><div style="font:700 11px/1.4 Arial,Helvetica,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#367E23;margin:0 0 8px">Zapytanie <span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹numer›</span></div><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse"><tr><td style="padding:9px 14px 9px 0;width:36%;vertical-align:top;font:13px/1.45 Arial,Helvetica,sans-serif;color:#5A615B">Dla</td><td style="padding:9px 0;vertical-align:top;font:600 14.5px/1.45 Arial,Helvetica,sans-serif;color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹firma / instytucja›</span></td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:9px 14px 9px 0;width:36%;vertical-align:top;font:13px/1.45 Arial,Helvetica,sans-serif;color:#5A615B">Lista</td><td style="border-top:1px solid #DDE2DA;padding:9px 0;vertical-align:top;font:600 14.5px/1.45 Arial,Helvetica,sans-serif;color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹liczba sztuk i pozycji›</span></td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:9px 14px 9px 0;width:36%;vertical-align:top;font:13px/1.45 Arial,Helvetica,sans-serif;color:#5A615B">Linie</td><td style="border-top:1px solid #DDE2DA;padding:9px 0;vertical-align:top;font:600 14.5px/1.45 Arial,Helvetica,sans-serif;color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹które zespoły (np. Biznes — sprzęt IT, Instalacje — monitoring)›</span></td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:9px 14px 9px 0;width:36%;vertical-align:top;font:13px/1.45 Arial,Helvetica,sans-serif;color:#5A615B">Termin</td><td style="border-top:1px solid #DDE2DA;padding:9px 0;vertical-align:top;font:600 14.5px/1.45 Arial,Helvetica,sans-serif;color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹wymagany termin›</span></td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:9px 14px 9px 0;width:36%;vertical-align:top;font:13px/1.45 Arial,Helvetica,sans-serif;color:#5A615B">Miejsce dostawy</td><td style="border-top:1px solid #DDE2DA;padding:9px 0;vertical-align:top;font:600 14.5px/1.45 Arial,Helvetica,sans-serif;color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹miejscowość›</span></td></tr></table></td></tr></table><div style="margin:6px 0 10px"><div style="font:700 11px/1.4 Arial,Helvetica,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#367E23;margin:0 0 8px">Co dalej</div><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;max-width:600px"><tr><td style="width:40px;vertical-align:top;padding:0 0 12px"><div style="width:28px;height:28px;border-radius:14px;background:#367E23;border:1.5px solid #367E23;color:#FFFFFF;font:700 13px/28px Arial,Helvetica,sans-serif;text-align:center">1</div></td><td style="vertical-align:top;padding:4px 0 12px;font:15px/1.55 Arial,Helvetica,sans-serif;color:#1F2421">Sprawdzamy dostępność i ceny u dystrybutorów.</td></tr><tr><td style="width:40px;vertical-align:top;padding:0 0 12px"><div style="width:28px;height:28px;border-radius:14px;background:#FFFFFF;border:1.5px solid #45A02C;color:#367E23;font:700 13px/28px Arial,Helvetica,sans-serif;text-align:center">2</div></td><td style="vertical-align:top;padding:4px 0 12px;font:15px/1.55 Arial,Helvetica,sans-serif;color:#1F2421">Przygotujemy ofertę z podziałem na pozycje do <strong style="color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹kiedy›</span></strong>.</td></tr><tr><td style="width:40px;vertical-align:top;padding:0 0 12px"><div style="width:28px;height:28px;border-radius:14px;background:#FFFFFF;border:1.5px solid #45A02C;color:#367E23;font:700 13px/28px Arial,Helvetica,sans-serif;text-align:center">3</div></td><td style="vertical-align:top;padding:4px 0 12px;font:15px/1.55 Arial,Helvetica,sans-serif;color:#1F2421">Usługi dodatkowe (konfiguracja, montaż, szkolenie) wyceniamy osobno — tylko jeśli są Państwu potrzebne.</td></tr></table></div><p style="margin:0 0 14px"><span style="border-bottom:1px dashed #C9A400">Sprzęt RTV i AGD dostarczamy pod adres, bez montażu i podłączenia.</span> <span style="font-size:11px;color:#8A918B">(usuń, jeśli nie dotyczy)</span></p><p style="margin:0 0 14px">Pozdrawiamy serdecznie,</p></div>"`;

exports[`snapshots (probka-wzorzec) > software/opieka 1`] = `"<div style="font:15px/1.6 Arial,Helvetica,sans-serif;color:#1F2421;max-width:600px"><p style="margin:0 0 14px">Dzień dobry,</p><p style="margin:0 0 14px">żeby strona działała bezpiecznie i szybko także za rok, proponujemy stałą opiekę. Do wyboru trzy poziomy:</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;max-width:600px;margin:4px 0 18px;border:1px solid #DDE2DA"><tr><th align="left" style="padding:9px 12px;font:700 11px/1.3 Arial,Helvetica,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#5A615B;background:#F3F4F1">Poziom</th><th align="left" style="padding:9px 12px;font:700 11px/1.3 Arial,Helvetica,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#5A615B;background:#F3F4F1">Co zawiera</th><th align="right" style="padding:9px 12px;font:700 11px/1.3 Arial,Helvetica,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#5A615B;background:#F3F4F1">Cena</th></tr><tr><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">Podstawowa</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">serwer w Polsce i domena, kopia co noc, aktualizacje; reakcja do końca następnego dnia roboczego</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;text-align:right;white-space:nowrap;">149 zł netto/mies.</td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">Standard (polecana)</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">jak Podstawowa + monitoring 24/7, drobne zmiany do 1 h/mies., raport co miesiąc; reakcja 8 h roboczych</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;text-align:right;white-space:nowrap;">299 zł netto/mies.</td></tr><tr><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">Systemy</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;">jak Standard + eksport danych co miesiąc, rozwój do 4 h/mies.; reakcja 4 h roboczych, na piśmie</td><td style="border-top:1px solid #DDE2DA;padding:10px 12px;font:400 14px/1.45 Arial,Helvetica,sans-serif;color:#121613;text-align:right;white-space:nowrap;">790 zł netto/mies.</td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:separate;max-width:600px;margin:4px 0 18px;background:#ECF7EE;border-radius:12px"><tr><td style="width:4px;background:#2E8B4A;border-radius:12px 0 0 12px"></td><td style="padding:13px 18px;font:14.5px/1.55 Arial,Helvetica,sans-serif;color:#1F2421"><div style="font:700 14.5px/1.4 Arial,Helvetica,sans-serif;color:#1F6B36;margin-bottom:3px">W każdej opiece</div>Dane i kod należą do Państwa — eksport danych na każde żądanie, bez uwiązania.</td></tr></table><p style="margin:0 0 14px">Dla Państwa strony polecamy <strong style="color:#121613"><span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹poziom: Podstawową / Standard / Systemy›</span></strong>, bo <span style="background:#FFF0A6;border-radius:3px;padding:0 3px">‹dlaczego›</span>.</p><p style="margin:0 0 14px">Pozdrawiamy serdecznie,</p></div>"`;
