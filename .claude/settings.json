{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm format*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git show *)",
      "Bash(git rev-list *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git branch --unset-upstream*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm payload migrate)",
      "Bash(pnpm payload migrate:create *)",
      "Bash(pnpm payload migrate:status*)",
      "Bash(pnpm seed*)",
      "Bash(pnpm generate:*)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm prettier *)",
      "Bash(pnpm exec *)",
      "Bash(PORT=* pnpm test:e2e*)",
      "Bash(pnpm -s typecheck*)",
      "Bash(pnpm -s lint*)",
      "Bash(pnpm -s test*)",
      "Bash(pnpm -s vitest run *)",
      "Bash(pnpm -s payload migrate:status*)",
      "Bash(PORT=* pnpm -s test:e2e*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view *)",
      "Bash(gh run list*)",
      "Bash(docker ps*)",
      "Bash(docker exec prokom-web-dev-postgres-1 *)",
      "Bash(docker cp *)",
      "Bash(docker compose -f docker/compose.dev.yml *)",
      "Bash(docker build *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Edit(./src/**)",
      "Edit(./tests/**)",
      "Edit(./docs/**)",
      "Edit(./seed/**)",
      "Edit(./scripts/**)",
      "Edit(./public/**)"
    ],
    "ask": [
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm install)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.staging)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(git push --force-with-lease*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo delete*)",
      "Bash(pnpm payload migrate:down*)",
      "Bash(pnpm payload migrate:fresh*)",
      "Bash(pnpm payload migrate:reset*)",
      "Bash(docker compose -f docker/compose.dev.yml down -v*)",
      "Bash(docker volume rm*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
