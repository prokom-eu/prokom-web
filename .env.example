# prokom-web — environment variables (template).
# Copy to .env and fill in. Never commit .env. Real values live in the password manager
# (entry "prokom-web .env lokalny"). Validation: src/lib/env.ts — the app will not start
# if a required variable is missing or invalid.

# Runtime mode: development | test | production. Next.js sets it automatically for
# `pnpm dev` / `pnpm build`; usually leave it unset locally.
# NODE_ENV=development

# PostgreSQL connection string (required). The default matches docker/compose.dev.yml.
DATABASE_URL=postgresql://prokom:prokom@127.0.0.1:54320/prokom_web

# Secret used by Payload to sign tokens and encrypt data (required, at least 32 characters).
# Different value per environment. Generate one, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
