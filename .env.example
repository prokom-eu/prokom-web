# prokom-web — environment variables (template).
# Copy to .env and fill in. Never commit .env. Real values live in the password manager
# (entry "prokom-web .env lokalny"). Validation: src/lib/env.ts — the app will not start
# if a required variable is missing or invalid.

# Runtime mode: development | test | production. Next.js sets it automatically for
# `pnpm dev` / `pnpm build`; usually leave it unset locally.
# NODE_ENV=development

# PostgreSQL connection string (required). The default matches docker/compose.dev.yml.
DATABASE_URL=postgresql://prokom:prokom@127.0.0.1:54320/prokom_web

# Secret used by Payload to sign tokens and encrypt data (required, at least 32 characters).
# Different value per environment. Generate one, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Domain of the admin panel (required): `/admin` and the Payload API respond only on this host,
# every other domain gets 404 there (ADR-006). Hostname only, without scheme or port.
# Local: panel.localhost (open http://panel.localhost:3000/admin). Production: panel.pro-kom.eu.
PANEL_HOST=panel.localhost

# Local admin created by `pnpm seed` (local development only; the seed refuses to run when
# NODE_ENV=production). Optional for the app itself — required only by the seed.
# Password: at least 12 characters. Keep the same values on both computers (password manager).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Directory for uploaded files (optional, default: media — relative to the app directory,
# already in .gitignore). Each upload collection gets a subfolder (media/, partners/).
# On the server: a Docker volume mounted e.g. at /app/media (S9). Backups include it.
# MEDIA_DIR=media

# Deployment kind (optional, default: local): production | staging | local.
# staging → every page gets noindex and robots.txt disallows everything (the staging server
# is also behind a password, S10). local → addresses in canonical/sitemap use http://.
# SITE_ENV=local
