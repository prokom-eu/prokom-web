# PRO-KOM Tech staging (stack `prokom-tech-staging` from the prokom-system repo). Added by the
# overlay compose.proxy.tech-staging.yml only when the `prokom-tech-staging` certificate exists —
# nginx does not start with a server block whose certificate is missing.

server {
  listen 80;
  server_name ${TECH_STAGING_HOST};
  include /etc/nginx/snippets/acme.conf;
}

server {
  include /etc/nginx/snippets/tls.conf;
  server_name ${TECH_STAGING_HOST};
  ssl_certificate /etc/letsencrypt/live/prokom-tech-staging/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/prokom-tech-staging/privkey.pem;
  set $app prokom-tech-staging-gateway-1:80;
  include /etc/nginx/snippets/staging.conf;
  include /etc/nginx/snippets/tech.conf;
}
